{
    "meta": {
        "name": "triple_rules_v1_1",
        "raw_evt_type_count_core_v1_1": 18,
        "normalized_relation_count_core_v1_1": 9,
        "newly_supported_raw_evt_type": [
            "clone3",
            "fork",
            "vfork",
            "pread",
            "readv",
            "pwrite",
            "writev",
            "accept"
        ],
        "rule_count_by_tier_raw_evt_type": {
            "core": 18,
            "auxiliary": 7,
            "filtered": 9
        },
        "rule_entry_count_by_tier": {
            "core": 10,
            "auxiliary": 7,
            "filtered": 9
        }
    },
    "identity": {
        "subject_process_key": {
            "format": "proc:{container_id}:{pid}:{exepath}",
            "container_id_fallback": "host",
            "pid_priority": [
                "proc.pid",
                "proc.vpid",
                "unknown_pid"
            ],
            "exepath_priority": [
                "proc.exepath",
                "proc.name",
                "unknown_exe"
            ]
        },
        "object_file_key": {
            "format": "file:{path}",
            "path_priority": [
                "evt.arg.filename",
                "fd.name",
                "evt.arg.newpath",
                "evt.arg.oldpath",
                "unknown_path"
            ]
        },
        "object_conn_key": {
            "format": "conn:{src_ip}:{src_port}->{dst_ip}:{dst_port}",
            "priority": [
                "fd.name_if_conn_like",
                "fd.sip+fd.sport+fd.cip+fd.cport",
                "fd.lip+fd.sport+fd.rip+fd.cport",
                "unknown_conn"
            ],
            "direction_convention": "prefer client->server",
            "session_reuse_principle": [
                "bucket events by unordered 4-tuple",
                "assign one canonical directed conn key per bucket",
                "reuse same conn key for connect/accept/send/recv",
                "if direction undecidable, keep first-seen direction and store direction_hint"
            ]
        },
        "object_child_process_key": {
            "format": "proc:{container_id}:{child_pid}:{child_exepath_or_unknown}",
            "child_pid_priority": [
                "evt.arg.pid",
                "evt.rawres",
                "unknown_child"
            ]
        }
    },
    "attrs_policy": {
        "must_keep": [
            "raw_evt_type",
            "evt_num",
            "timestamp",
            "malicious"
        ],
        "reason": "preserve syscall-level detail after normalization"
    },
    "core_rules": [
        {
            "rule_id": "C1",
            "raw_evt_type": [
                "openat"
            ],
            "normalized_relation": "FILE_OPEN",
            "triple_pattern": "process->file",
            "tier": "core",
            "weight_hint": "low_weight_core",
            "subject_rule": "proc:{container.id|host}:{proc.pid|proc.vpid}:{proc.exepath|proc.name}",
            "object_rule": "file:{evt.arg.filename|fd.name}",
            "attrs_keep": [
                "raw_evt_type",
                "evt.datetime",
                "evt.num",
                "evt.category",
                "evt.rawres",
                "proc.name",
                "proc.pid",
                "proc.exepath",
                "container.id",
                "fd.name",
                "fd.type",
                "fd.num"
            ],
            "notes": [
                "FILE_OPEN marks first contact with file object.",
                "Skip if fd.type indicates network endpoint."
            ],
            "example": {
                "input_json": {
                    "evt.type": "openat",
                    "evt.category": "file",
                    "evt.datetime": "2026-02-07 09:35:00.123456789",
                    "evt.num": 12001,
                    "proc.pid": 39655,
                    "proc.exepath": "/usr/local/bin/python3.12",
                    "proc.name": "python",
                    "container.id": "8e3ed5e3d1b3",
                    "evt.arg.filename": "/app/data/users.db",
                    "fd.name": "/app/data/users.db",
                    "fd.type": "file"
                },
                "output_triple": {
                    "subject": "proc:8e3ed5e3d1b3:39655:/usr/local/bin/python3.12",
                    "relation": "FILE_OPEN",
                    "object": "file:/app/data/users.db",
                    "attrs": {
                        "raw_evt_type": "openat",
                        "evt_num": 12001,
                        "timestamp": "2026-02-07 09:35:00.123456789"
                    }
                }
            }
        },
