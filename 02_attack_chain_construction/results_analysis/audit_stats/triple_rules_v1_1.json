    "unification_notes": [
        {
            "normalized_relation": "FILE_OPEN",
            "raw_evt_type_family": [
                "openat",
                "open"
            ],
            "why_unify": "same semantic: process starts touching file object",
            "details_preserved_in_attrs": [
                "raw_evt_type",
                "evt.num",
                "fd.*"
            ]
        },
        {
            "normalized_relation": "FILE_READ",
            "raw_evt_type_family": [
                "read",
                "pread",
                "readv"
            ],
            "why_unify": "same semantic: process reads data",
            "details_preserved_in_attrs": [
                "raw_evt_type",
                "evt.rawres",
                "fd.*"
            ]
        },
        {
            "normalized_relation": "FILE_WRITE",
            "raw_evt_type_family": [
                "write",
                "pwrite",
                "writev"
            ],
            "why_unify": "same semantic: process writes data",
            "details_preserved_in_attrs": [
                "raw_evt_type",
                "evt.rawres",
                "fd.*"
            ]
        },
        {
            "normalized_relation": "PROCESS_FORK",
            "raw_evt_type_family": [
                "clone",
                "clone3",
                "fork",
                "vfork"
            ],
            "why_unify": "same semantic: parent-child process creation",
            "details_preserved_in_attrs": [
                "raw_evt_type",
                "evt.rawres",
                "evt.arg.pid"
            ]
        },
        {
            "normalized_relation": "NET_ACCEPT",
            "raw_evt_type_family": [
                "accept",
                "accept4"
            ],
            "why_unify": "same semantic: server accepts inbound connection",
            "details_preserved_in_attrs": [
                "raw_evt_type",
                "fd.*"
            ]
        }
    ],
